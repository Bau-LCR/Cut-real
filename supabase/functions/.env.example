# Secretos de las Edge Functions. Cargalos con:  supabase secrets set --env-file supabase/functions/.env
# (NUNCA subas el archivo .env real al repositorio)

# Proveedores de IA (el NOMBRE de cada variable se registra en la tabla cr_providers.api_key_env)
GROQ_API_KEY=
GEMINI_API_KEY=

# Seguridad
ALLOWED_ORIGINS=https://TU_USUARIO.github.io,http://localhost:5173

# Búsqueda web (opcional): tavily | brave
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=

# Voz (opcional). STT usa GROQ_API_KEY. TTS externo OpenAI-compatible:
STT_MODEL=whisper-large-v3-turbo
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
