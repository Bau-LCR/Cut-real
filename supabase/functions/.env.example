# Secretos de las Edge Functions. Cargalos con:  supabase secrets set --env-file supabase/functions/.env
# (NUNCA subas el archivo .env real al repositorio)

# Proveedores de IA (registrá cada proveedor/slot en cr_providers usando api_key_env; secretos solo en Supabase)
GROQ_API_KEY=
GROQ_API_KEY_SLOT_2=
GROQ_API_KEY_SLOT_3=
GROQ_API_KEY_SLOT_4=
GROQ_API_KEY_SLOT_5=
GEMINI_API_KEY=
GEMINI_API_KEY_SLOT_2=
GEMINI_API_KEY_SLOT_3=

# Seguridad
ALLOWED_ORIGINS=https://TU_USUARIO.github.io,http://localhost:5173

# Búsqueda web (opcional): tavily | brave
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=

# Voz (opcional). STT usa GROQ_API_KEY. TTS usa Gemini de forma predeterminada si GEMINI_API_KEY está configurada.
TTS_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
STT_MODEL=whisper-large-v3-turbo
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=

# Integración opcional y bidireccional con Memory Task (secrets solo en Supabase)
MEMORY_TASK_API_URL=
MEMORY_TASK_API_KEY=
MEMORY_TASK_APP_ID=
MEMORY_TASK_IDENTITY_PRIVATE_JWK=
