{
  "name": "cut-real-2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/make-brand-assets.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:push": "npx supabase db push",
    "fn:deploy": "npx supabase functions deploy chat admin api transcribe tts generate-document memory-task-pairing",
    "secrets:set": "npx supabase secrets set --env-file supabase/functions/.env",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:secrets"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@fontsource-variable/space-grotesk": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@supabase/supabase-js": "^2.45.0",
    "katex": "^0.16.11",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.6.82",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "sharp": "^0.33.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
