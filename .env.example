# Frontend (público). Estas dos variables SÍ pueden ir en el navegador.
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY

# Ruta base de publicación: "/" o "/nombre-del-repo/" para GitHub Pages
VITE_BASE=/

# ⚠️ NUNCA pongas acá la service_role, GROQ_API_KEY ni otros secretos:
# todo lo que empieza con VITE_ termina visible en el navegador.
# Los secretos van en supabase/functions/.env (ver docs/DEPLOY.md).
